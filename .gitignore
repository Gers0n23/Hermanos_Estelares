# Godot 4
.godot/
*.translation

# Exports / builds
exports/
*.apk
*.aab
*.exe
*.pck

# Credenciales de export (firma Android)
export_credentials.cfg
*.keystore

# Herramientas externas clonadas (godot-mcp, etc.) — los scripts propios de herramientas/ SI se versionan
herramientas/godot-mcp/

# Sistema
Thumbs.db
.DS_Store

# Worktrees temporales de subagentes
.claude/worktrees/

# Credenciales locales (ver .env.example). NUNCA subir al repo.
.env

# Cache de Python de las herramientas
__pycache__/
*.pyc

# Respaldos automaticos de Krita y editores
*-autosave.kra
*~

# Hojas de contacto de herramientas/ojos.gd (revisión visual del agente, efímeras)
.ojos/

# Recuerdos familiares (fotos y voces reales de la familia): NUNCA subir al repo.
# Solo viajan dentro del APK. Catalogo y placeholders si se versionan (docs/fichas/album-recuerdos.md).
assets/recuerdos/fotos/
assets/recuerdos/voces/

# Imagenes "favoritos" de Parejas (PO 17-Oct-2026): bajadas de wikis de fans, con copyright de
# terceros. Uso familiar sin publicar: el repo es publico, asi que NO se suben. Se regeneran con
# `python -I herramientas/descargar_favoritos.py` (el catalogo datos/favoritos/catalogo.json si se versiona).
assets/sprites/favoritos/
